rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Read access is public for general user inspection (Read-Only)
    // Write access is enabled for asset management operations and updates
    match /assets/{assetId} {
      allow read: if true;
      allow write: if true;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    match /locations/{locationId} {
      allow read: if true;
      allow write: if true;
    }
    match /logs/{logId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
